---
import { 
  PERSONAL_NAME,
  PERSONAL_IMAGE_ALT,
  PERSONAL_IMAGE_URL,
  START_YEAR,
  FIRST_WORK_YEAR,
  LINKEDIN_URL,
  AVAILABILITY_TEXT,
  LAST_UPDATE,
  workExperience,
  overallExperience,
  TEAMWORK,
  TECH_JAVASCRIPT_YEARS,
  TECH_TYPESCRIPT_YEARS,
  TECH_REACT_YEARS,
  TECH_ANGULAR_YEARS,
  EDUCATION_YEARS,
  HOLBERTON_SPECIALIZATION_YEARS
} from '@/data/constants'
import Badge from "@/components/Badge.astro";
import CopyableElements from "@/components/CopyableElements.astro";


---

<div class="max-w-xl">
  <div class="flex gap-4 mb-4">
    <img
      class="rounded-full shadow-lg size-32 object-contain"
      src={PERSONAL_IMAGE_URL}
      alt={PERSONAL_IMAGE_ALT}
      loading="lazy"
    />
    <a
      href={LINKEDIN_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center transition md:justify-center md:hover:scale-105"
    >
      <Badge>{AVAILABILITY_TEXT}</Badge>
    </a>
  </div>
  <h1
    class="text-4xl font-bold tracking-tight text-gray-800 sm:text-5xl dark:text-white"
  >
    {PERSONAL_NAME}
  </h1>
  <p
    id="contacto"
    class="mt-6 text-xl text-gray-800 dark:[&>strong]:text-yellow-400 [&>strong]:text-sky-500 [&>strong]:font-semibold dark:text-gray-300"
  >
    Desde el {START_YEAR} en el mundo de la programación y desarrollo. <strong>Multimedia Engineer</strong>, <strong>Software Developer</strong> de Cali, Colombia. Especializado en el <strong>desarrollo de aplicaciones web</strong>.
  </p>
  <p
    class="mt-6 text-xl text-gray-800 dark:[&>strong]:text-yellow-400 [&>strong]:text-sky-500 [&>strong]:font-semibold dark:text-gray-300"
  >
    Experiencia laboral: {workExperience} años.
    Trabajo en equipo: {TEAMWORK} años.
    Javascript: {TECH_JAVASCRIPT_YEARS} años. 
    Typescript: {TECH_TYPESCRIPT_YEARS} años. 
    React: {TECH_REACT_YEARS} años. 
    Angular: {TECH_ANGULAR_YEARS} años. 
    Educación universitaria: {EDUCATION_YEARS} años. 
    Especialización: {HOLBERTON_SPECIALIZATION_YEARS} años.
    Trayectoria Tech: {overallExperience} años. 
  </p>
  
  <CopyableElements />
  <a href="/pdf/ES/kaelwebdev HV 2026 ES v2.1.pdf" download class="inline-flex items-center justify-center gap-2 px-4 py-1 text-gray-800 transition bg-gray-100 border border-gray-300 rounded-full dark:bg-gray-800 dark:border-gray-600  hover:dark:border-white dark:text-white focus-visible:ring-yellow-500/80 text-md hover:bg-gray-900 hover:border-gray-700 group max-w-fit hover:text-white focus:outline-none focus-visible:outline-none focus-visible:ring focus-visible:ring-white focus-visible:ring-offset-2 active:bg-black print:hidden">
    Descarga PDF ES
  </a>
  <a href="/pdf/EN/kaelwebdev HV 2026 EN v2.1.pdf" download class="inline-flex items-center justify-center gap-2 px-4 py-1 text-gray-800 transition bg-gray-100 border border-gray-300 rounded-full dark:bg-gray-800 dark:border-gray-600  hover:dark:border-white dark:text-white focus-visible:ring-yellow-500/80 text-md hover:bg-gray-900 hover:border-gray-700 group max-w-fit hover:text-white focus:outline-none focus-visible:outline-none focus-visible:ring focus-visible:ring-white focus-visible:ring-offset-2 active:bg-black print:hidden">
    Download PDF EN
  </a>
  <p
    class="mt-6 text-xl text-gray-800 dark:[&>strong]:text-yellow-400 [&>strong]:text-sky-500 [&>strong]:font-semibold dark:text-gray-300"
  >
    Última actualización {LAST_UPDATE}.
  </p>
</div>
